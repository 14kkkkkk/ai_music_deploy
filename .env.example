# ============================================
# AI 音乐服务配置文件
# ============================================

# Suno API 配置
SUNO_API_KEY=your_suno_api_key_here
SUNO_API_BASE_URL=https://api.sunoapi.org/api/v1

# 服务配置
PORT=3001
NODE_ENV=production

# 服务器 IP 配置（重要：部署时需要修改为实际服务器 IP）
SERVER_IP=47.252.36.81
CALLBACK_BASE_URL=http://47.252.36.81:3001

# 任务管理器配置
MAX_CONCURRENCY=10
MAX_QUEUE_SIZE=2500

# OSS 配置（音乐服务专用 OSS 接口）
OSS_SIGNED_URL_API=https://ai.mediaio.net/api/v1/ai/signed-upload-url
OSS_UPLOAD_TIMEOUT=60000

# 回调配置
CALLBACK_TIMEOUT=10000
CALLBACK_MAX_RETRIES=3
CALLBACK_RETRY_DELAY=2000

# 临时文件目录（音乐服务专用）
TEMP_DIR=./temp_audio

# 日志配置
LOG_LEVEL=info
LOG_DIR=logs

